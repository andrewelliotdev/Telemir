# ==========================================
# Telegram API Credentials (from https://my.telegram.org)
# ==========================================
API_ID=12345678
API_HASH=your_api_hash_here
BOT_TOKEN=
PHONE_NUMBER=+1234567890
SESSION_NAME=telegram_mirror_session

# String Session for Cloud Userbot (Generate with `python tools/export_session_string.py`)
# When set, the userbot runs headlessly without prompting for login codes.
SESSION_STRING=

# ==========================================
# Web Dashboard & Port Configuration
# ==========================================
PORT=10000
WEB_HOST=0.0.0.0
ADMIN_PASSWORD=admin123

# ==========================================
# Channel Configuration
# ==========================================
# Source channels to monitor (comma-separated usernames or numeric IDs)
# e.g. @source_channel_1, @source_channel_2, -1001234567890
SOURCE_CHANNELS=@source_channel

# Destination channels where messages will be mirrored
# e.g. @my_destination_channel or -1009876543210
DESTINATION_CHANNELS=@destination_channel

# Advanced channel mapping (JSON format, overrides SOURCE_CHANNELS/DESTINATION_CHANNELS if provided):
# Example: {"@source1": "@dest1", "@source2": "@dest2"}
# CHANNEL_MAPPING={"@source1": "@dest1"}

# ==========================================
# Bot Behavior Settings
# ==========================================
# Mode: 'clean_copy' (reposts message without forwarded tag) or 'forward' (standard Telegram forward)
COPY_MODE=clean_copy

# Delay in seconds between actions (helps avoid Telegram flood limits)
ACTION_DELAY=2.0

# Mirror edited messages from source channel to destination (true/false)
MIRROR_EDITS=true

# ==========================================
# Content Transformation & Filtering
# ==========================================
# Remove all HTTP/HTTPS links from copied messages (true/false)
REMOVE_LINKS=false

# Remove images/photos attached to posts (true = post text caption only, false = auto-post images as well)
REMOVE_IMAGES=false

# Words/Phrases to replace in text, JSON key-value format (e.g. {"OldChannel": "NewChannel", "@oldbot": "@mybot"})
REPLACE_MAP={}

# Filter out messages containing any of these keywords (comma-separated, case-insensitive)
BLACKLIST_KEYWORDS=promo,sponsor,ad

# Only mirror messages that contain at least one of these keywords (leave empty to allow all)
WHITELIST_KEYWORDS=

# Optional header or footer text appended to mirrored messages
CUSTOM_HEADER=
CUSTOM_FOOTER=

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=INFO
LOG_FILE=mirror_bot.log
